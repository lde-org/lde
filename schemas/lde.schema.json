{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["name", "version", "dependencies"],
	"definitions": {
		"featureFlag": {
			"anyOf": [
				{ "type": "string", "enum": ["windows", "linux", "android", "macos", "bsd", "unix"] },
				{ "type": "string" }
			]
		},
		"featureList": {
			"type": "array",
			"items": { "$ref": "#/definitions/featureFlag" },
			"description": "Feature flags to enable for this dependency"
		},
		"optionalFlag": {
			"type": "boolean",
			"description": "If true, the dependency is not required for the project to run"
		},
		"packageAlias": {
			"type": "string",
			"description": "Actual package name at the source, when it differs from the require key (aliasing)"
		},
		"rockspecPath": {
			"type": "string",
			"description": "Path to the rockspec file relative to the dependency directory"
		},
		"dependencyObject": {
			"type": "object",
			"additionalProperties": {
				"type": "object",
				"oneOf": [
					{
						"required": ["path"],
						"properties": {
							"path": {
								"type": "string",
								"description": "Local filesystem path to dependency"
							},
							"package": { "$ref": "#/definitions/packageAlias" },
							"rockspec": { "$ref": "#/definitions/rockspecPath" },
							"features": { "$ref": "#/definitions/featureList" },
							"optional": { "$ref": "#/definitions/optionalFlag" }
						},
						"additionalProperties": false
					},
					{
						"required": ["git"],
						"properties": {
							"git": {
								"type": "string",
								"description": "Git repository URL"
							},
							"branch": {
								"type": "string",
								"description": "Git branch to use"
							},
							"commit": {
								"type": "string",
								"description": "Git commit hash to pin"
							},
							"package": { "$ref": "#/definitions/packageAlias" },
							"rockspec": { "$ref": "#/definitions/rockspecPath" },
							"features": { "$ref": "#/definitions/featureList" },
							"optional": { "$ref": "#/definitions/optionalFlag" }
						},
						"additionalProperties": false
					},
					{
						"required": ["version"],
						"properties": {
							"version": {
								"type": "string",
								"description": "Registry package version or range to install, e.g. '^1.2.3', '1.2' or '>=1.2 <2'"
							},
							"package": { "$ref": "#/definitions/packageAlias" },
							"rockspec": { "$ref": "#/definitions/rockspecPath" },
							"features": { "$ref": "#/definitions/featureList" },
							"optional": { "$ref": "#/definitions/optionalFlag" }
						},
						"additionalProperties": false
					},
					{
						"required": ["luarocks"],
						"properties": {
							"luarocks": {
								"type": "string",
								"description": "Package name on luarocks.org"
							},
							"version": {
								"type": "string",
								"description": "Optional version constraint e.g. '>= 1.0'"
							},
							"package": { "$ref": "#/definitions/packageAlias" },
							"features": { "$ref": "#/definitions/featureList" },
							"optional": { "$ref": "#/definitions/optionalFlag" }
						},
						"additionalProperties": false
					},
					{
						"required": ["archive"],
						"properties": {
							"archive": {
								"type": "string",
								"description": "URL to an archive (.zip, .tar.gz, .tar.bz2, etc.)"
							},
							"package": { "$ref": "#/definitions/packageAlias" },
							"rockspec": { "$ref": "#/definitions/rockspecPath" },
							"features": { "$ref": "#/definitions/featureList" },
							"optional": { "$ref": "#/definitions/optionalFlag" }
						},
						"additionalProperties": false
					}
				]
			}
		}
	},
	"properties": {
		"name": {
			"type": "string",
			"pattern": "^(?:[a-z][a-z0-9_-]{1,}[a-z0-9]/)?[a-z](?:[a-z0-9_-]*[a-z0-9])?$",
			"maxLength": 128,
			"description": "Package name (optionally namespaced as ns/name; matches the registry naming rules)"
		},
		"version": {
			"type": "string",
			"pattern": "^\\d+\\.\\d+\\.\\d+$",
			"description": "Semantic version number"
		},
		"description": {
			"type": "string",
			"description": "Short description of the package"
		},
		"authors": {
			"type": "array",
			"items": { "type": "string" },
			"description": "List of package authors"
		},
		"dependencies": {
			"allOf": [
				{
					"$ref": "#/definitions/dependencyObject"
				},
				{
					"description": "Package dependencies with source locations"
				}
			]
		},
		"bin": {
			"type": "string",
			"description": "Entry point script to run when using lde run without a file argument"
		},
		"scripts": {
			"type": "object",
			"description": "Named scripts that can be run with lde run <name> or lde <name>",
			"additionalProperties": {
				"type": "string",
				"description": "Shell command to execute"
			}
		},
		"engine": {
			"type": "string",
			"enum": ["lua", "luajit", "lde"],
			"description": "The Lua engine to use"
		},
		"devDependencies": {
			"allOf": [
				{
					"$ref": "#/definitions/dependencyObject"
				},
				{
					"description": "Development dependencies with source locations"
				}
			]
		},
		"features": {
			"type": "object",
			"description": "Named feature groups, each listing the optional dependency aliases and `<package>.<module>` names its flag claims. The special `default` key lists feature flags enabled for this package by `lde add` and by root development builds.",
			"properties": {
				"default": {
					"type": "array",
					"items": { "type": "string" },
					"description": "Feature flags enabled by default when this package is added as a dependency or built as the project root"
				}
			},
			"additionalProperties": {
				"type": "array",
				"items": { "type": "string" },
				"description": "Dependency aliases and `<package>.<module>` names this feature flag claims"
			}
		},
		"android": {
			"type": "object",
			"description": "Android APK metadata for `lde compile --target android-aarch64-apk`",
			"properties": {
				"package": { "type": "string", "description": "Android application id, e.g. dev.example.app" },
				"label": { "type": "string", "description": "Name shown under the launcher icon" },
				"versionCode": { "type": "integer", "minimum": 1, "description": "Android version code" },
				"icon": { "type": "string", "description": "PNG launcher icon, relative to the package; 192x192 or larger" },
				"fullscreen": { "type": "boolean", "default": false, "description": "Hide the status bar. By default the system bars stay visible and the app is laid out under them" },
				"permissions": {
					"type": "array",
					"items": { "type": "string" },
					"description": "Permissions the app asks for, written as `uses-permission` entries, e.g. android.permission.READ_MEDIA_AUDIO"
				},
				"libs": {
					"type": "array",
					"items": { "type": "string" },
					"description": "Shared libraries to ship in the APK native library directory, relative to the package"
				},
				"dex": {
					"type": "string",
					"description": "A prebuilt classes.dex with the app's own Java code, relative to the package. Shipped as the APK's classes.dex; required for `services`"
				},
				"services": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"name": { "type": "string", "description": "Fully qualified class name of the service, in `dex`" },
							"foregroundServiceType": { "type": "string", "description": "e.g. mediaPlayback; needs the matching FOREGROUND_SERVICE_* permission" }
						},
						"required": ["name"],
						"additionalProperties": false
					},
					"description": "`<service>` entries for the manifest, for services implemented in `dex`"
				}
			},
			"additionalProperties": false
		}
	},
	"additionalProperties": false
}
