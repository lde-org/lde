---
import Layout from "../layouts/Layout.astro";
import InstallTabs from "../components/InstallTabs";
import TerminalDemo from "../components/TerminalDemo";
import { GITHUB_RELEASES_URL, GITHUB_URL } from "../data/info";
import BenchmarkChart from "../components/BenchmarkChart";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const latestRelease = posts.find((p) => p.data.title.toLowerCase().startsWith("release"));

const comparison = [
	{ feature: "Written in", href: "/docs/general/getting-started/introduction", subtitle: "Performant fine-tuned LuaJIT", values: ["Lua", "Teal", "Rust"] },
	{ feature: "Luarocks compatibility", href: "/docs/package-manager/dependencies/luarocks-support", subtitle: "Intends to provide full compatibility", values: ["wip", "y", "wip"] },
	{ feature: "Built-in test runner", href: "/docs/test-runner/getting-started/test-runner", subtitle: "Includes coverage reporting", values: ["y:lde-test", "n", "y:busted"] },
	{ feature: "Ships with LuaJIT", href: "/docs/runtime/getting-started/runtime", subtitle: "No need to install lua on your system", values: ["y", "n", "n"] },
	{ feature: "Comes with a compiler suite", href: "/docs/bundler/guides/compiling", subtitle: "Windows can compile rocks effortlessly", values: ["y", "n", "n"] },
	{ feature: "Compile to executable", href: "/docs/bundler/guides/compiling", subtitle: "Compile <1mB programs that run anywhere", values: ["y", "n", "n"] },
	{ feature: "Git deps", href: "/docs/package-manager/dependencies/dependencies", subtitle: "Also supports monorepos", values: ["y", "n", "y"] },
	{ feature: "Monorepo support", href: "/docs/package-manager/guides/monorepos", subtitle: "Run commands across workspaces with proper package typings", values: ["y", "n", "y"] },
	{ feature: "Custom Registry", href: "/docs/package-manager/guides/custom-registry", subtitle: "A modern, fast registry", values: ["y", "y", "n"] },
	{ feature: "Lua build scripts", href: "/docs/package-manager/dependencies/build-scripts", subtitle: "Supports custom build scripts", values: ["a:build.lua", "rockspec", "rockspec"] },
	{ feature: "Teal support", href: "/docs/runtime/guides/teal", subtitle: "First class support without configuration", values: ["y", "n", "n"] },
	{ feature: "MoonScript support", href: "/docs/runtime/guides/moonscript", subtitle: "First class support without configuration", values: ["y", "n", "n"] },
	{ feature: "Interactive REPL", href: "/docs/runtime/guides/repl", subtitle: "Works with project dependencies", values: ["y", "n", "n"] },
	{ feature: "Hot reloading", href: "/docs/runtime/guides/hot-reload", subtitle: "Reload changed modules without restarting the process", values: ["y", "n", "n"] },
];

const features = [
	{
		href: "/docs/runtime/getting-started/runtime",
		icon: `<polyline points="4 17 10 11 4 5"></polyline><line x1="12" x2="20" y1="19" y2="19"></line>`,
		title: "Runtime",
		desc: "Cross platform latest LuaJIT served hot and ready.<br/>No painful build needed.",
		cmd: "lde ./file.lua",
	},
	{
		href: "/docs/package-manager/getting-started/quick-start",
		icon: `<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>`,
		title: "Package Manager",
		desc: "Download packages from lde or luarocks, build on any platform.<br/>Yes, even Windows.",
		cmd: "lde add <package>",
	},
	{
		href: "/docs/test-runner/getting-started/test-runner",
		icon: `<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>`,
		title: "Test Runner",
		desc: "A fast, minimal test runner with coverage, profiling, and monorepo support.",
		cmd: "lde test",
	},
	{
		href: "/docs/bundler/getting-started/single-file-apps",
		icon: `<path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path>`,
		title: "Bundler & Compiler",
		desc: "Compile to &lt;1mB binaries and run on any machine.<br/>It's that easy.",
		cmd: "lde compile",
	},
];
---

<Layout hideGlow>
<main>
	<!-- ─── HERO ─────────────────────────────────────────────────────────── -->
	<section class="relative flex flex-col items-center justify-center overflow-hidden min-h-[calc(100vh-72px)] px-6 py-24">

		<!-- Background glow blobs -->
		<div class="absolute inset-0 pointer-events-none select-none" aria-hidden="true">
			<!-- Top-center blue glow -->
			<div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[900px] h-[600px] rounded-full bg-blue-600/10 dark:bg-blue-500/15 blur-[80px]"></div>
			<!-- Bottom accent -->
			<div class="absolute bottom-0 left-1/4 w-[500px] h-[300px] rounded-full bg-indigo-600/8 dark:bg-indigo-500/10 blur-[70px]"></div>

			<!-- Star field -->
			<svg class="absolute inset-0 w-full h-full opacity-60 dark:opacity-100" viewBox="0 0 1400 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<pattern id="stars-a" width="97" height="83" patternUnits="userSpaceOnUse">
						<circle cx="12" cy="18" r="0.8" fill="#94a3b8"></circle>
						<circle cx="58" cy="8" r="0.6" fill="#94a3b8"></circle>
						<circle cx="81" cy="47" r="0.9" fill="#94a3b8"></circle>
						<circle cx="28" cy="65" r="0.7" fill="#94a3b8"></circle>
						<circle cx="72" cy="71" r="0.6" fill="#94a3b8"></circle>
						<circle cx="43" cy="38" r="0.5" fill="#94a3b8"></circle>
					</pattern>
					<pattern id="stars-b" width="113" height="97" patternUnits="userSpaceOnUse" x="37" y="25">
						<circle cx="22" cy="44" r="0.7" fill="#94a3b8"></circle>
						<circle cx="78" cy="12" r="0.9" fill="#94a3b8"></circle>
						<circle cx="100" cy="73" r="0.6" fill="#94a3b8"></circle>
						<circle cx="47" cy="82" r="0.8" fill="#94a3b8"></circle>
						<circle cx="91" cy="55" r="0.6" fill="#94a3b8"></circle>
						<circle cx="15" cy="30" r="0.5" fill="#94a3b8"></circle>
						<circle cx="55" cy="55" r="0.5" fill="#94a3b8"></circle>
					</pattern>
				</defs>
				<rect width="1400" height="800" fill="url(#stars-a)" opacity="0.5"></rect>
				<rect width="1400" height="800" fill="url(#stars-b)" opacity="0.4"></rect>
				<!-- Bright accent stars -->
				<circle cx="148" cy="115" r="1.8" fill="#60a5fa" opacity="0.8"></circle>
				<circle cx="375" cy="72" r="1.4" fill="#60a5fa" opacity="0.7"></circle>
				<circle cx="595" cy="188" r="1.6" fill="#818cf8" opacity="0.75"></circle>
				<circle cx="218" cy="478" r="1.5" fill="#60a5fa" opacity="0.7"></circle>
				<circle cx="1295" cy="195" r="1.6" fill="#60a5fa" opacity="0.7"></circle>
				<circle cx="1248" cy="548" r="1.5" fill="#818cf8" opacity="0.75"></circle>
				<circle cx="732" cy="58" r="1.4" fill="#60a5fa" opacity="0.6"></circle>
				<circle cx="955" cy="598" r="1.6" fill="#60a5fa" opacity="0.65"></circle>
				<circle cx="88" cy="355" r="1.4" fill="#818cf8" opacity="0.65"></circle>
				<circle cx="472" cy="528" r="1.3" fill="#60a5fa" opacity="0.6"></circle>
				<circle cx="1100" cy="380" r="1.5" fill="#818cf8" opacity="0.6"></circle>
				<circle cx="650" cy="700" r="1.4" fill="#60a5fa" opacity="0.55"></circle>
			</svg>
		</div>

		<!-- Shooting stars -->
		<div class="absolute inset-0 pointer-events-none select-none overflow-hidden" aria-hidden="true">
			<span class="shooting-star" style="left: 80%; top: -40px; animation-duration: 14s;"></span>
			<span class="shooting-star" style="left: 92%; top: -80px; animation-duration: 18s; animation-delay: -6s;"></span>
			<span class="shooting-star" style="left: 60%; top: -60px; animation-duration: 23s; animation-delay: -13s;"></span>
			<span class="shooting-star" style="left: 70%; top: -25px; animation-duration: 29s; animation-delay: -21s;"></span>
		</div>

		<!-- Hero content -->
		<div class="relative z-10 flex flex-col lg:flex-row items-center justify-center gap-16 xl:gap-24 w-full max-w-7xl mx-auto">

			<!-- Left: text + install -->
			<div class="flex flex-col items-center lg:items-start text-center lg:text-left max-w-2xl w-full">

				<!-- Badge -->
				{latestRelease && (
					<a
						href={`/blog/${latestRelease.id}`}
						class="mb-6 inline-flex items-center gap-2 px-3 py-1.5 border border-blue-600/30 bg-blue-500/10 text-white text-xs font-medium hover:bg-blue-500/20 transition-colors"
					>
						{latestRelease.data.title} is out
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-blue-300 animate-bounce-x"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
					</a>
				)}

				<h1 class="text-5xl md:text-6xl xl:text-7xl font-semibold tracking-tight leading-[1.05]">
					Lua Done{" "}
					<span class="relative inline-block">
						Easy
						<span class="absolute inset-x-0 bottom-1 -z-10 h-[3px] bg-blue-600"></span>
					</span>
				</h1>

				<p class="mt-6 text-lg text-black/60 dark:text-white/55 leading-relaxed max-w-md">
					A cross platform package manager, runtime, test runner and compiler that turns your programs into single executables in &lt; <span class="text-black/80 dark:text-white/80 font-medium">1mB</span>.
				</p>

				<div class="mt-8 w-full">
					<InstallTabs client:idle />
				</div>
			</div>

			<!-- Right: terminal demo -->
			<div class="relative hidden lg:flex items-center justify-center">
				<!-- Glow behind terminal -->
				<div class="absolute inset-0 bg-blue-500/15 dark:bg-blue-500/12 rounded-full blur-2xl scale-75 pointer-events-none"></div>
				<div class="relative z-10">
					<TerminalDemo client:load />
				</div>
			</div>
		</div>

		<!-- Scroll hint -->
		<div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-black/25 dark:text-white/20 animate-bounce">
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
		</div>
	</section>

	<!-- ─── FEATURES ─────────────────────────────────────────────────────── -->
	<section class="w-full border-t border-black/8 dark:border-white/8 px-6 py-24">
		<div class="max-w-7xl mx-auto">
			<div class="text-center mb-16">
				<h2 id="features" class="text-4xl md:text-5xl font-bold tracking-tight scroll-mt-20">One tool, <i>all</i> of Lua</h2>
				<p class="mt-4 text-black/50 dark:text-white/40 text-lg max-w-xl mx-auto">
					Write, test, and ship Lua in a single simple install.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
				{features.map((f, i) => (
					<a
						href={f.href}
						class="feature-card glow-card group relative border border-black/8 dark:border-white/8 bg-black/[0.02] dark:bg-white/[0.02] p-8 hover:border-blue-600/40 hover:bg-blue-500/[0.04] transition-all duration-300 flex flex-col gap-5 overflow-hidden"
					>
						<!-- Top shimmer on hover -->
						<div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-500/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

						<!-- Cursor glow -->
						<div class="glow-spot pointer-events-none absolute size-44 -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-600/10 dark:bg-blue-600/15 blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

						<!-- Icon top right -->
						<div class="absolute top-8 right-8 size-11 bg-blue-500/10 border border-blue-600/20 flex items-center justify-center text-blue-400 group-hover:bg-blue-500/15 transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
						</div>

						<div class="min-w-0 pr-16">
							<h3 class="text-lg font-semibold mb-1.5">{f.title}</h3>
							<p class="text-md text-black/50 dark:text-white/40 leading-relaxed" set:html={f.desc} />
						</div>

						<code class="mt-auto text-sm text-blue-400 bg-blue-500/10 border border-blue-600/15 px-3 py-2 w-fit font-mono">
							$ {f.cmd}
						</code>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ─── TOOLS ───────────────────────────────────────────────────────── -->
	<section class="w-full border-t border-black/8 dark:border-white/8 px-6 py-24">
		<div class="max-w-7xl mx-auto">
			<div class="text-center mb-16">
				<h2 id="tools" class="text-4xl md:text-5xl font-bold tracking-tight scroll-mt-20">The tools you've always wanted</h2>
				<p class="mt-4 text-black/50 dark:text-white/40 text-lg max-w-xl mx-auto">
					Everything you need, built into one binary.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-5">
				<!-- Test Runner -->
				<a
					href="/docs/test-runner/getting-started/test-runner"
					class="glow-card group relative border border-black/8 dark:border-white/8 bg-black/[0.02] dark:bg-white/[0.02] p-8 flex flex-col gap-6 overflow-hidden hover:border-blue-600/40 hover:bg-blue-500/[0.04] transition-all duration-300"
				>
					<div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-500/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
					<div class="glow-spot pointer-events-none absolute size-44 -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-600/10 dark:bg-blue-600/15 blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

					<h3 class="text-lg font-semibold flex items-center gap-3">
						<span class="size-8 bg-blue-500/10 border border-blue-600/20 flex items-center justify-center text-blue-400 shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
						</span>
						Test Runner
					</h3>

					<!-- test run in the background -->
					<div class="absolute inset-x-0 inset-y-0 flex items-center opacity-20 pointer-events-none select-none" aria-hidden="true">
						<div class="w-full px-8 font-mono text-[10px] leading-snug">
							<div class="text-black/60 dark:text-white/60"><span class="text-emerald-600 dark:text-emerald-400">✓</span> <span class="font-semibold text-black/60 dark:text-white/60">add.test.lua</span></div>
							<div class="text-black/60 dark:text-white/60"><span class="text-emerald-600 dark:text-emerald-400">✓</span> lde add creates the dependencies field <span class="text-black/30 dark:text-white/30">(3ms)</span></div>
							<div class="text-black/60 dark:text-white/60"><span class="text-emerald-600 dark:text-emerald-400">✓</span> lde add --dev --git adds a git dep <span class="text-black/30 dark:text-white/30">(4ms)</span></div>
							<div class="text-black/60 dark:text-white/60"><span class="text-emerald-600 dark:text-emerald-400">✓</span> lde remove removes the dep entry <span class="text-black/30 dark:text-white/30">(3ms)</span></div>
							<div class="mt-1 text-[11px]"><span class="font-semibold text-emerald-600 dark:text-emerald-400">3 passed</span>, <span class="text-cyan-600 dark:text-cyan-400">3 total</span></div>
							<div class="mt-1 text-black/40 dark:text-white/40">coverage <span class="text-emerald-600 dark:text-emerald-400">100.0%</span> <span class="text-emerald-600 dark:text-emerald-400">████████████████</span><span class="text-black/20 dark:text-white/20">░░</span></div>
						</div>
					</div>

					<ul class="relative mt-auto space-y-2.5">
						<li class="flex items-start gap-2.5 text-sm text-black/70 dark:text-white/60">
							<span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-blue-600 text-white">
								<svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
							</span>
							<span>Runs fast</span>
						</li>
						<li class="flex items-start gap-2.5 text-sm text-black/70 dark:text-white/60">
							<span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-blue-600 text-white">
								<svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
							</span>
							<span>Coverage supported</span>
						</li>
						<li class="flex items-start gap-2.5 text-sm text-black/70 dark:text-white/60">
							<span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-blue-600 text-white">
								<svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
							</span>
							<span>Source output with errors</span>
						</li>
					</ul>
				</a>

				<!-- Profiler -->
				<a
					href="/docs/runtime/guides/profiling"
					class="glow-card group relative border border-black/8 dark:border-white/8 bg-black/[0.02] dark:bg-white/[0.02] p-8 flex flex-col gap-6 overflow-hidden hover:border-blue-600/40 hover:bg-blue-500/[0.04] transition-all duration-300"
				>
					<div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-500/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
					<div class="glow-spot pointer-events-none absolute size-44 -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-600/10 dark:bg-blue-600/15 blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

					<h3 class="text-lg font-semibold flex items-center gap-3">
						<span class="size-8 bg-blue-500/10 border border-blue-600/20 flex items-center justify-center text-blue-400 shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
						</span>
						Profiler
					</h3>

					<!-- profiler output + flamegraph in the background -->
					<div class="absolute inset-x-0 inset-y-0 flex items-center opacity-20 pointer-events-none select-none" aria-hidden="true">
						<!-- flamegraph, bleeding to the card edges -->
						<div class="absolute inset-x-0 bottom-0 flex h-24 items-end gap-[2px]">
							{[
								{ h: 35, c: "bg-amber-400" },
								{ h: 55, c: "bg-orange-400" },
								{ h: 40, c: "bg-amber-500" },
								{ h: 75, c: "bg-orange-500" },
								{ h: 50, c: "bg-amber-400" },
								{ h: 65, c: "bg-orange-400" },
								{ h: 35, c: "bg-amber-500" },
								{ h: 85, c: "bg-orange-500" },
								{ h: 45, c: "bg-amber-400" },
								{ h: 60, c: "bg-orange-400" },
								{ h: 30, c: "bg-amber-500" },
								{ h: 70, c: "bg-orange-500" },
								{ h: 40, c: "bg-amber-400" },
								{ h: 80, c: "bg-orange-500" },
								{ h: 50, c: "bg-amber-400" },
								{ h: 60, c: "bg-orange-400" },
								{ h: 35, c: "bg-amber-500" },
								{ h: 70, c: "bg-orange-400" },
								{ h: 45, c: "bg-amber-500" },
								{ h: 78, c: "bg-orange-500" },
							].map(({ h, c }) => <div class={`flex-1 ${c}`} style={`height:${h}%`}></div>)}
						</div>
						<div class="relative w-full px-8 font-mono text-[10px] leading-snug">
							<div class="text-black/40 dark:text-white/40">Profile · <span class="text-cyan-600 dark:text-cyan-400">~25ms</span> · 25 samples @ 1ms</div>
							<div class="text-black/20 dark:text-white/20">──────────────────────────────────────────</div>
							<div class="mt-0.5 font-semibold text-black/60 dark:text-white/60">VM State</div>
							<div class="text-yellow-600 dark:text-yellow-400">Interpreted  <span class="text-yellow-600 dark:text-yellow-400">█</span><span class="text-black/20 dark:text-white/20">░░░░░░░░░░░░░░░░░░░</span>  <span class="text-black/40 dark:text-white/40">4.0%</span></div>
							<div class="text-cyan-600 dark:text-cyan-400">C code       <span class="text-cyan-600 dark:text-cyan-400">████████████████</span><span class="text-black/20 dark:text-white/20">░░░░</span>  <span class="text-black/40 dark:text-white/40">80.0%</span></div>
							<div class="text-fuchsia-600 dark:text-fuchsia-400">JIT compiler <span class="text-fuchsia-600 dark:text-fuchsia-400">███</span><span class="text-black/20 dark:text-white/20">░░░░░░░░░░░░░░░░░░░</span>  <span class="text-black/40 dark:text-white/40">16.0%</span></div>
							<div class="mt-0.5 font-semibold text-black/60 dark:text-white/60">Hotspots</div>
							<div class="text-black/20 dark:text-white/20">──────────────────────────────────────────</div>
