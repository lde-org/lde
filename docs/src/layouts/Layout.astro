---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CodeBlocks from "../components/CodeBlocks.tsx";
import { SITE_URL } from "../data/info";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	hideFooter?: boolean;
	hideGlow?: boolean;
	hasTabs?: boolean;
}

const DEFAULT_DESCRIPTION =
	"An open-source package manager, runtime and test runner providing easy accessibility to lua.";

const {
	title,
	description = DEFAULT_DESCRIPTION,
	hideFooter = false,
	hideGlow = false,
	hasTabs = false,
} = Astro.props;
const pageTitle = title ? `${title} - lde` : "lde";
const ogSlug = Astro.url.pathname.replace(/^\/|\/$/g, "") || "index";
const ogImage = `${SITE_URL}/og/${ogSlug}.png`;
---

<html lang="en" class="dark overflow-y-scroll">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/lde-text.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Preload Lato (400/700 + italics) so fonts arrive before first paint --
		     without this, display=swap swaps them in after paint and the whole
		     hero jumps ~15px (layout shift). -->
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			crossorigin
			href="https://fonts.gstatic.com/s/lato/v25/S6uyw4BMUTPHjx4wXg.woff2"
		/>
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			crossorigin
			href="https://fonts.gstatic.com/s/lato/v25/S6u9w4BMUTPHh6UVSwiPGQ.woff2"
		/>
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			crossorigin
			href="https://fonts.gstatic.com/s/lato/v25/S6u8w4BMUTPHjxsAXC-q.woff2"
		/>
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			crossorigin
			href="https://fonts.gstatic.com/s/lato/v25/S6u_w4BMUTPHjxsI5wq_Gwft.woff2"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap"
			rel="stylesheet"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=Rubik:wght@400..700&display=swap"
			rel="stylesheet"
		/>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="lde" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:url" content={SITE_URL + Astro.url.pathname} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link
			rel="alternate"
			type="application/rss+xml"
			title="lde blog"
			href="/rss.xml"
		/>
	</head>
	<body
		class="relative overflow-x-clip antialiased bg-white dark:bg-gray-950 text-black dark:text-white flex flex-col min-h-screen"
	>
		<!-- Ambient page glow (hidden on index which has its own hero fx) -->
		{!hideGlow && (
			<div class="absolute inset-x-0 top-0 pointer-events-none select-none" aria-hidden="true">
				<div class="absolute top-[-400px] left-1/2 -translate-x-1/2 w-[800px] h-[800px] rounded-full bg-blue-500/[0.07] dark:bg-blue-500/[0.09] blur-[60px]"></div>
			</div>
		)}
		<Navbar hasTabs={hasTabs}><slot name="tabs" slot="default" /></Navbar>
		<slot />
		{!hideFooter && <Footer />}
		<CodeBlocks client:only="preact" />
	</body>
</html>
