---
import Search from "./Search.tsx";

interface Props {
	hasTabs?: boolean;
}
const { hasTabs = false } = Astro.props;

const entries = [
	{ display: "Docs", href: "/docs/general/getting-started/introduction" },
	{ display: "Blog", href: "/blog/" },
	{ display: "Registry", href: "/registry/" },
	{ display: "Download", href: "/download" },
];

const pathname = Astro.url.pathname;
function isActive(href: string) {
	if (href === "/docs/general/getting-started/introduction")
		return false;
	return pathname.startsWith(href);
}
---

<nav
	class={`sticky top-0 z-50 bg-white/70 dark:bg-gray-950/0 backdrop-blur-md px-4 md:px-6 flex flex-col items-center justify-start border-b border-black/10 dark:border-white/10${hasTabs ? " min-h-[7rem]" : ""}`}
>
	<div class="flex flex-row items-center h-[4.5rem] w-full max-w-[90em]">
		<a
			href="/"
			class="font-brand font-semibold text-2xl tracking-tight p-2 md:p-4 flex items-center gap-2.5"
		>
			<span class="relative inline-flex">
				<span class="absolute inset-0 rounded-full bg-white/20 blur-xl" aria-hidden="true"></span>
				<img
					src="/lde.svg"
					alt="lde logo"
					class="relative size-9 object-contain"
				/>
			</span>
			lde
		</a>

		<!-- Desktop nav links -->
		<div class="hidden md:flex ml-16 h-full flex-row items-stretch">
			{
				entries.map((entry) => (
					<a
						href={entry.href}
						class={`group relative flex h-full items-center overflow-hidden px-4 font-medium transition-colors duration-200 ${isActive(entry.href) ? "text-white" : "hover:text-white"}`}
					>
						<span
							class={`absolute inset-0 bg-blue-600 transition-transform duration-200 ease-out ${isActive(entry.href) ? "translate-y-0" : "translate-y-full group-hover:translate-y-0"}`}
							aria-hidden="true"
						></span>
						<span class="relative font-bold">{entry.display}</span>
					</a>
				))
			}
		</div>

		<div class="ml-auto mr-2 md:mr-4">
			<Search client:load />
		</div>

		<div class="flex items-center gap-0 md:gap-2">
			<!-- Burger button (mobile only) -->
			<button
				id="nav-burger"
				aria-label="Toggle menu"
				aria-expanded="false"
				class="md:hidden opacity-60 hover:opacity-100 p-2 transition-opacity cursor-pointer"
			>
				<svg
					id="burger-icon"
					class="size-5"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
				<svg
					id="close-icon"
					class="size-5 hidden"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile dropdown -->
	<div
		id="mobile-menu"
		class="hidden md:hidden w-full border-t border-black/10 dark:border-white/10 py-2"
	>
		{
			entries.map((entry) => (
				<a
					href={entry.href}
					class={`flex items-center px-2 py-3 font-medium rounded-md transition ${isActive(entry.href) ? "bg-blue-500/15 text-blue-500" : "hover:bg-black/5 dark:hover:bg-white/5"}`}
				>
					{entry.display}
				</a>
			))
		}
	</div>

	<div class={hasTabs ? "min-h-[2.5rem] w-full" : ""}>
		<slot />
	</div>

	<script>
		// Burger toggle
		const burger = document.getElementById("nav-burger")!;
		const menu = document.getElementById("mobile-menu")!;
		const burgerIcon = document.getElementById("burger-icon")!;
		const closeIcon = document.getElementById("close-icon")!;

		burger.addEventListener("click", () => {
			const open = menu.classList.toggle("hidden");
			burger.setAttribute("aria-expanded", String(!open));
			burgerIcon.classList.toggle("hidden", !open);
			closeIcon.classList.toggle("hidden", open);
		});
	</script>
</nav>
