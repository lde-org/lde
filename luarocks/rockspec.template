local ldeVersion = "@VERSION@"

package = "lde"
version = ldeVersion .. "-@REVISION@"

source = {
	url = "@SOURCE_URL@",
	dir = "@SOURCE_DIR@",
}

description = {
	summary = "A package manager, test runner and runtime for Lua, written in Lua.",
	homepage = "https://lde.sh",
	license = "MIT",
}

dependencies = {
	"lua >= 5.1",
}

build = {
	type = "command",
	install_command = "sh install.sh @INSTALL_ARGS@",
	platforms = {
		windows = {
			install_command = "powershell -NoProfile -ExecutionPolicy Bypass -File install.ps1 @INSTALL_ARGS@",
		},
	},
}
